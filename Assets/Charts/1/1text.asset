  m_Script: {fileID: 11500000, guid: 0752420be1a96f841b50e066e3fe0def, type: 3}
  m_Name: 1text
  m_EditorClassIdentifier: Assembly-CSharp::InterferenceTextConfig
  textContents:
  - "\u7834\u9632\u4E86\u7834\u9632\u4E86  \u8FD9\u4E0B\u771F\u7EA2\u6E29\u4E86 
    \u9AD8\u80FD\u573A\u9762\u9884\u8B66      \u7ECF\u5178\u65E0\u80FD\u72C2\u6012\u73B0\u573A   
    \u4E3B\u64AD\u8981\u7EF7\u4E0D\u4F4F\u4E86     \u6B63\u4E49\u4F7F\u8005\u5728\u7EBF\u5236\u88C1    
    \u770B\u4ED6\u8FD8\u600E\u4E48\u5634\u786C   \u5168\u7A0B\u8212\u9002\uFF0C\u770B\u5F97\u592A\u89E3\u6C14      
    \u683C\u5C40\u4E00\u4E0B\u5B50\u5C31\u62C9\u5F00\u4E86\u7F51\u7EA2\u6EE4\u955C\u76F4\u63A5\u788E\u4E86  
    \u522B\u66B4\u8E81\u4E86\u597D\u597D\u8BF4\u8BDD"
  - " \u7EBF\u4E0A\u91CD\u62F3\u7EBF\u4E0B\u552F\u552F\u8BFA\u8BFA       \u8FD9\u6CE2\u5BF9\u7EBF\u5B8C\u80DC          
    \u60C5\u7EEA\u7BA1\u7406\u5F7B\u5E95\u4E0B\u7EBF      \u5403\u74DC\u7FA4\u4F17\u5DF2\u5C31\u4F4D         
    \u7EC8\u4E8E\u6709\u4EBA\u6CBB\u5F97\u4E86\u4ED6   \u5634\u5F3A\u738B\u8005\u9047\u5230\u5BF9\u624B\u4E86      
    \u539F\u5730\u66B4\u8D70\u540D\u573A\u9762         \u623E\u6C14\u4E5F\u592A\u91CD\u4E86\u5427       
    \u5750\u7B49\u4E3B\u64AD\u5F53\u573A\u7834\u9632"
  - "\u597D\u597D\u597D\u8FFD\u7740\u6BD2\u7624\u6740     \u53C8\u662F\u6765\u78B0\u74F7\u8E6D\u70ED\u5EA6\u7684          
    \u5634\u4E0A\u4E0D\u5F3A\u6C42\u773C\u775B\u76EF\u7740\u699C\u5355\u5462          
    \u8FD9\u5957 PUA \u5957\u8DEF\u592A\u719F    \u5403\u76F8\u522B\u592A\u96BE\u770B\u4E86\u554A      
    \u628A\u7C89\u4E1D\u5F53\u97ED\u83DC\u4F7F\u52B2\u8585    \u865A\u4F2A\u8FD9\u4E00\u5757\u62FF\u634F\u6B7B\u6B7B\u7684    
    \u7EC8\u4E8E\u6709\u4EBA\u62C6\u7A7F\u4ED6\u4E86"
  - " \u5473\u518D\u8DB3\u4E5F\u586B\u4E0D\u6EE1\u8D2A\u5FC3     \u5178\u578B\u5634\u4E0A\u4F5B\u7CFB\u5FC3\u91CC\u8D2A\u5A6A  
    \u76F4\u64AD\u5957\u8DEF\u90FD\u73A9\u660E\u767D\u4E86       \u522B\u88C5\u65E0\u8F9C\u4E86\u8C01\u90FD\u770B\u5F97\u61C2            
    \u5C31\u559C\u6B22\u6697\u793A\u4E0D\u76F4\u8BF4\u662F\u5427      \u6536\u5272\u6D41\u91CF\u5C5E\u5B9E\u6709\u4E00\u5957          
    \u5403\u74DC\u770B\u620F\u5750\u7B49\u88AB\u5BF9\u7EBF     \u4EBA\u8BBE\u6EE4\u955C\u5F7B\u5E95\u788E\u4E00\u5730  
    \u771F\u5B9E\u5634\u8138\u85CF\u4E0D\u4F4F\u4E86"
