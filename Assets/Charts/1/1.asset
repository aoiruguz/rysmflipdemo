  enemyInfo: "\u7EBF\u4E0A\u7EA2\u6E29\u5486\u54EE\u738B\uFF0C\u7EBF\u4E0B\u51B7\u9759\u5236\u88C1\u8005\uFF01\n\u4E00\u8FB9\u662F\u60C5\u7EEA\u5931\u63A7\u3001\u65E0\u80FD\u72C2\u6012\u7684\u66B4\u6012\u7F51\u7EA2\uFF0C\n\u4E00\u8FB9\u662F\u5634\u5F3A\u738B\u8005\u3001\u771F\u7406\u5728\u63E1\u7684\u91D1\u724C\u8BB2\u5E08\u3002\n\u8282\u594F\u5BF9\u51B3\uFF0C\u4E00\u97F3\u5B9A\u80DC\u8D1F\uFF01"
