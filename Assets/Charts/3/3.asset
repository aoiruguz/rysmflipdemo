  openingDialogues:
  - panelIndex: 1
    speakerName: 
    text: "\u4E3A\u4EC0\u4E48\u603B\u6709\u5C0F\u9ED1\u5B50\u76EF\u7740\u6211\u9ED1\uFF1F\u6211\u6CA1\u60F9\u4EFB\u4F55\u4EBA\uFF0C"
  - panelIndex: 1
    speakerName: 
    text: "\u80AF\u5B9A\u662F\u7B97\u6CD5\u6545\u610F\u628A\u6211\u63A8\u7ED9\u9ED1\u5B50\uFF01"
  - panelIndex: 1
    speakerName: 
    text: "\u8FD9\u6837\u5E73\u53F0\u624D\u6709\u6D41\u91CF\uFF0C\u5C31\u4F1A\u6709\u66F4\u591A\u4EBA\u9760\u9ED1\u6211\u8D77\u53F7\uFF01"
  - panelIndex: 1
    speakerName: 
    text: "\u8EAB\u5FC3\u4FF1\u75B2\u2026\u2026\u8981\u4E0D\u8981\u62D4\u7F51\u7EBF\u4F11\u606F\u4E00\u9635\uFF1F"
  - panelIndex: 1
    speakerName: 
    text: "\u4E0D\u884C\uFF01\u8FD9\u662F\u6211\u4EB2\u624B\u8981\u5230\u7684\u6D41\u91CF\u996D\u4E0D\u80FD\u5C31\u8FD9\u4E48\u7B97\u4E86\uFF01"
  - panelIndex: 1
    speakerName: 
    text: "\u6211\u8FD8\u8981\u53BB\u62A8\u51FB\u6BD2\u7624\uFF01\u4F38\u5F20\u6B63\u4E49\uFF01\u7F51\u7EDC\u8FD8\u9700\u8981\u6211\uFF01"
  - panelIndex: 2
    speakerName: 
    text: "\u6CA1\u6709\u4EBA\u6BD4\u6211\u66F4\u61C2\u6D41\u91CF\uFF0C\u4E0D\u5982\u6211\u4EEC\u4E00\u8D77\u76F4\u64AD\u53CC\u8D62\uFF01"
  - panelIndex: 1
    speakerName: 
    text: "\u4F60\u8DD1\u5230\u6211\u76F4\u64AD\u95F4\uFF0C\u4E00\u5B9A\u662F\u5AC9\u5992\u6211\u7684\u7C89\u4E1D\u8E6D\u70ED\u5EA6\uFF01"
  - panelIndex: 1
    speakerName: 
    text: "\u6CA1\u6709\u4EBA\u53EF\u4EE5\u6BC1\u6389\u6211\u79EF\u7D2F\u8D77\u6765\u7684\u7684\u4E00\u5207\uFF01"
