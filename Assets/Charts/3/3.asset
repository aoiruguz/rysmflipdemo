  enemyAvatar: {fileID: 21300000, guid: 1ae0c03dacda87e48949b79f77702d60, type: 3}
  enemyAvatarDefeated: {fileID: 21300000, guid: 4622717303eea1348889b04403ee5bd0, type: 3}
