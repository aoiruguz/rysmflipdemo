  openingDialogues:
  - panelIndex: 1
    speakerName: 
    text: "\u4F60\u4EEC\u5E72\u4EC0\u4E48\uFF1F\u4E0D\u662F\u8BF4\u597D\u4E00\u751F\u63A8\u5417\uFF1F"
  - panelIndex: 3
    speakerName: 
    text: "\u4F60\u592A\u8BA9\u6211\u4EEC\u5931\u671B\u4E86\u2026perfect\u592A\u5C11\u2026\u584C\u623F...\u623F..."
