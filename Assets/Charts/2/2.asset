  enemyInfo: "\u5927\u80C3\u888B\u72C2\u70AB\u6D41\u91CF\uFF0C\u6B63\u4E49\u5E08\u6233\u7834\u8D2A\u5A6A\uFF01\n\u4E00\u8FB9\u662F\u5634\u4E0A\u4F5B\u7CFB\u3001\u5FC3\u91CC\u8D2A\u6EE1\u7684\u5403\u64AD\u4E00\u54E5\uFF0C\n\u4E00\u8FB9\u662F\u770B\u7834\u5957\u8DEF\u3001\u6574\u987F\u4E71\u8C61\u7684\u8282\u594F\u5E26\u5E08\u3002\n\u6309\u51C6\u8282\u62CD\uFF0C\u51FB\u788E\u865A\u4F2A\uFF01"
  enemyFans: 10000
  enemyTitleUncleared: "\u5FEB\u811A\u5341\u4F73\u6574\u6D3B\u4F6C"
  enemyTitleCleared: "\u524D\u5FEB\u811A\u5341\u4F73\u6574\u6D3B\u4F6C"
  chapterGroup: 2
