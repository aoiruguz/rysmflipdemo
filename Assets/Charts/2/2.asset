  openingDialogues:
  - panelIndex: 2
    speakerName: BOSS
    text: "\u60F3\u652F\u6301\u5C31\u968F\u624B\u610F\u601D\u4E00\u4E0B\uFF0C\u81EA\u613F\u5C31\u5B8C\u4E8B\u4E86\u3002 "
  - panelIndex: 1
    speakerName: "\u4E3B\u89D2"
    text: "\u5634\u4E0A\u8BF4\u7740\u4E0D\u5F3A\u6C42\uFF0C\u5B9E\u9645\u4E0A\u53E5\u53E5\u90FD\u5728\u6697\u793A\u6002\u607F\uFF01"
  - panelIndex: 1
    speakerName: "\u4E3B\u89D2"
    text: "\u9AA8\u5B50\u91CC\u5C31\u662F\u8D2A\u5A6A\u6210\u6027\uFF0C\u53EA\u60F3\u6536\u5272\u7C89\u4E1D\u94B1\u5305\u3002"
  - panelIndex: 2
    speakerName: BOSS
    text: "\u6211\u7C89\u4E1D\u81EA\u613F\u5BA0\u6211\uFF0C\u8FD9\u662F\u6211\u7684\u4EBA\u683C\u9B45\u529B\uFF01"
  - panelIndex: 1
    speakerName: "\u4E3B\u89D2"
    text: "\u6211\u4E0D\u4FE1\uFF0C\u4F60\u4E00\u5B9A\u662FPUA\u7ED1\u67B6\u7C89\u4E1D\u7ED9\u4F60\u5237\u793C\u7269\uFF01"
  - panelIndex: 1
    speakerName: "\u4E3B\u89D2"
    text: "\u6211\u4ECA\u5929\u5C31\u8981\u66FF\u5929\u5BF9\u7EBF\uFF0C\u4F38\u5F20\u6B63\u4E49\uFF01"
  - panelIndex: 2
    speakerName: BOSS
    text: "\u4F60\u6765\u6211\u76F4\u64AD\u95F4\u8E6D\u70ED\u5EA6\uFF0C\u4F60\u624D\u662F\u771F\u7684\u8D2A\u5427\uFF01"
  - panelIndex: 1
    speakerName: "\u4E3B\u89D2"
    text: "\u6211\u4E0D\u88C5\u4E86\uFF0C\u6211\u644A\u724C\u4E86\uFF0C\u6211\u5C31\u662F\u8981\u6D41\u91CF\uFF01"
  - panelIndex: 1
    speakerName: "\u4E3B\u89D2"
    text: "\u6BCF\u4E2A\u4EBA\u90FD\u6709\u673A\u4F1A\u8D70\u7EA2\uFF0C\u4E3A\u4EC0\u4E48\u4E0D\u80FD\u662F\u6211\uFF1F"
  - panelIndex: 1
    speakerName: "\u4E3B\u89D2"
    text: "\u4E0E\u5176\u8BA9\u4F60\u8D70\u7EA2\u6536\u5272\u7C89\u4E1D\uFF0C\u4E0D\u5982\u8BA9\u6211\u6765\u4F38\u5F20\u6B63\u4E49\uFF01"
