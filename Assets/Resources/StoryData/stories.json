          "rightCharacter": {
            "spritePath": "bingfeilinshizichan/lz1",
            "scale": 1.0
          },
          "backgroundSpritePath": "",
          "audioClipPath": ""
        },
        {
          "characterName": "粮砸",
          "dialogueText": "天天摆烂干饭、套路粉丝，确实是我格局小了。味再足也填不满贪心的窟窿……",
          "speakerPosition": "left",
          "leftCharacter": {
            "spritePath": "bingfeilinshizichan/playercat1",
            "scale": 1.0
          },
          "rightCharacter": {
            "spritePath": "bingfeilinshizichan/lz1",
            "scale": 1.0
          },
          "backgroundSpritePath": "",
          "audioClipPath": ""
        },
        {
          "characterName": "粮砸",
          "dialogueText": "我彻底被训服了！第 57 个民族，味真族全族集合！今天起导师的话就是圣经！",
          "speakerPosition": "right",
          "leftCharacter": {
            "spritePath": "bingfeilinshizichan/playercat1",
            "scale": 1.0
