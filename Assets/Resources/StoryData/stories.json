          "backgroundSpritePath": "",
          "audioClipPath": ""
        },
        {
          "characterName": "懂大王",
          "dialogueText": "这一波是秦始皇照镜子——双赢！能让我抬不起头的，只有太阳… 还有你，",
          "speakerPosition": "left",
          "leftCharacter": {
            "spritePath": "bingfeilinshizichan/playercat1",
            "scale": 1.0
          },
          "rightCharacter": {
            "spritePath": "bingfeilinshizichan/pepe11",
            "scale": 1.0
          },
          "backgroundSpritePath": "",
          "audioClipPath": ""
        },
        {
          "characterName": "懂大王",
          "dialogueText": "但是伟大的导师，你说的是我还是你？",
          "speakerPosition": "right",
          "leftCharacter": {
            "spritePath": "bingfeilinshizichan/playercat1",
