    {
      "storyId": "MainStory_Chapter1_Stage1_Clear",
      "storyName": "第一关通关剧情",
      "triggerType": 1,
      "triggerCondition": "MainStory_Chapter1_Stage1",
      "dialogues": [
        {
          "characterName": "主角",
          "dialogueText": "内个，你现在服了吗？",
          "speakerPosition": "left",
          "leftCharacter": {
            "spritePath": "bingfeilinshizichan/playercat1",
