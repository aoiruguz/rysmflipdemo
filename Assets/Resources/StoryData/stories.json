    {
      "storyId": "Level_04_Opening",
      "storyName": "第四关开场-存在的质问",
      "triggerType": 0,
      "triggerCondition": "Big Map",
      "dialogues": [
        {
          "characterName": "",
          "dialogueText": "战斗结束瞬间，屏幕变静。无数张张开的嘴悬浮在空中，没有五官只有黑洞般的瞳孔，它们随着你的呼吸频率开合。",
          "characterSpritePath": "小猫",
          "backgroundSpritePath": "第四关1",
          "audioClipPath": ""
        },
        {
          "characterName": "",
          "dialogueText": "背景音不是音乐，而是成千上万个点赞、转发声组成的白噪音，最后汇聚成一个低沉的嗡鸣。",
          "characterSpritePath": "小猫",
          "backgroundSpritePath": "第四关2",
          "audioClipPath": ""
        },
        {
          "characterName": "",
          "dialogueText": "嘴巴里吐出的字是像素块拼凑而成的，会不断重组。",
          "characterSpritePath": "小猫",
          "backgroundSpritePath": "第四关3",
          "audioClipPath": ""
        },
        {
          "characterName": "",
          "dialogueText": "你是在发声，还是在被听见？",
          "characterSpritePath": "小猫",
          "backgroundSpritePath": "第四关4",
          "audioClipPath": ""
        },
        {
          "characterName": "",
          "dialogueText": "你是主宰者，还是回声的一部分？",
          "characterSpritePath": "小猫",
          "backgroundSpritePath": "第四关5",
          "audioClipPath": ""
        }
      ]
    },
    {
      "storyId": "MainStory_Chapter1_Stage1_Clear",
      "storyName": "第一关通关剧情",
      "triggerType": 1,
      "triggerCondition": "MainStory_Chapter1_Stage1",
      "dialogues": [
        {
          "characterName": "主角",
          "dialogueText": "内个，你现在服了吗？",
          "characterSpritePath": "",
          "backgroundSpritePath": "",
          "audioClipPath": ""
        },
        {
          "characterName": "BOSS",
          "dialogueText": "我 —— 算 —— 个 —— 屁！！！",
          "characterSpritePath": "",
          "backgroundSpritePath": "",
          "audioClipPath": ""
        },
        {
          "characterName": "主角",
          "dialogueText": "线下唯唯诺诺，网上重拳出击，纯属网络巨婴\n别拿冲动当热血，别拿发疯做性格，\n红温破防只会暴露你格局小、心智不成熟。\n真正的强者都是淡定控场、逻辑碾压，\n从来不靠大吼大叫撑排面。",
          "characterSpritePath": "",
          "backgroundSpritePath": "",
          "audioClipPath": ""
        },
        {
          "characterName": "BOSS",
          "dialogueText": "以后… 我跟导师混！又要到饭了，兄弟们！\n这波是流量饭，不丢人！一点不丢人！",
          "characterSpritePath": "",
          "backgroundSpritePath": "",
          "audioClipPath": ""
        }
      ]
    }
  ]
}
