          "rightCharacter":{
            "spritePath": "bingfeilinshizichan/lz1",
            "scale": 1.0
          },
          "backgroundSpritePath": "",
          "audioClipPath": ""
        },
        {
          "characterName": "主角",
          "dialogueText": "正义可不会伸张它自己，流量就该给我！让我来伸张正义，审判网络毒瘤！",
