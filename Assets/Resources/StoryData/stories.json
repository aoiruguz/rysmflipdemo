          "rightCharacter": {
            "spritePath": "bingfeilinshizichan/speed1",
            "scale": 1.0
          },
          "backgroundSpritePath": "",
          "audioClipPath": ""
        },
        {
          "characterName": "BOSS",
          "dialogueText": "我 —— 算 —— 个 —— 屁！！！",
          "speakerPosition": "right",
          "leftCharacter": {
            "spritePath": "bingfeilinshizichan/playercat1",
            "scale": 1.0
          },
          "rightCharacter": {
            "spritePath": "bingfeilinshizichan/speed1",
            "scale": 1.0
          },
          "backgroundSpritePath": "",
          "audioClipPath": ""
        },
        {
          "characterName": "主角",
          "dialogueText": "线下唯唯诺诺，网上重拳出击，纯属网络巨婴\n别拿冲动当热血，别拿发疯做性格，\n红温破防只会暴露你格局小、心智不成熟。\n真正的强者都是淡定控场、逻辑碾压，\n从来不靠大吼大叫撑排面。",
          "speakerPosition": "left",
          "leftCharacter": {
            "spritePath": "bingfeilinshizichan/playercat1",
            "scale": 1.0
          },
          "rightCharacter": {
            "spritePath": "bingfeilinshizichan/speed1",
            "scale": 1.0
          },
          "backgroundSpritePath": "",
          "audioClipPath": ""
        },
        {
          "characterName": "BOSS",
          "dialogueText": "以后… 我跟导师混！又要到饭了，兄弟们！\n这波是流量饭，不丢人！一点不丢人！",
          "speakerPosition": "right",
          "leftCharacter": {
            "spritePath": "bingfeilinshizichan/playercat1",
            "scale": 1.0
          },
          "rightCharacter": {
            "spritePath": "bingfeilinshizichan/speed11",
            "scale": 1.0
          },
          "backgroundSpritePath": "",
          "audioClipPath": ""
        }
      ]
    },
    {
